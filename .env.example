# Fichier .env.example - Copier en .env pour le développement local

# === Configuration Serveur ===
PORT=8080
HOST=0.0.0.0
READ_TIMEOUT=30
WRITE_TIMEOUT=30
SHUTDOWN_TIMEOUT=5

# === Storage Configuration ===
# Options: local, s3, gcs, azure
STORAGE_TYPE=local

# Storage Local (dev)
STORAGE_LOCAL_PATH=./storage

# === S3-Compatible Storage ===
# Fonctionne avec: AWS S3, MinIO, DigitalOcean Spaces, Scaleway, etc.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=facturx
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_USE_PATH_STYLE=true
# S3_FORCE_PATH_STYLE=false

# === Google Cloud Storage ===
# GCS avec S3-compatible API (HMAC keys)
# STORAGE_TYPE=gcs
# S3_ENDPOINT=https://storage.googleapis.com
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=your-gcs-access-key
# S3_SECRET_KEY=your-gcs-secret-key
# GCS_PROJECT_ID=your-project-id
# GCS_CREDENTIALS_PATH=/path/to/credentials.json

# === Azure Blob Storage ===
# STORAGE_TYPE=azure
# AZURE_ACCOUNT_NAME=your-account
# AZURE_ACCOUNT_KEY=your-key
# AZURE_CONTAINER=facturx

# === Authentication ===
AUTH_ENABLED=true
AUTH_API_KEY=my-secret-api-key-for-backend-calls
AUTH_PASSWORD=my-secure-password-for-ui
# e.g openssl rand -hex 64
AUTH_JWT_SECRET=super-secret-key-change-me-in-production

# === UI & Frontend ===
# Activer l'interface web Angular servie par l'API (production)
WEB_UI_ENABLED=true
# WEB_UI_PATH=./web/ng

# === Moteur de Rendu Universel (fX v2 Render Engine) ===
# Backend de compilation Typst :
#   - auto : utilise le Turbo Daemon Rust (typst-renderd) si disponible, sinon fallback sur CLI worker pool
#   - rust : impose l'utilisation du daemon Rust typst-renderd
#   - cli  : utilise uniquement le pool de workers CLI Typst sandboxé
RENDER_BACKEND=auto

# Nombre de workers concurrents pour la compilation (0 = détection automatique CPU / runtime.NumCPU())
RENDER_WORKERS=0

# Chemin du socket Unix pour communiquer avec typst-renderd (latence minimale en mono-hôte / Docker)
RENDER_DAEMON_SOCKET=/tmp/typst-renderd.sock

# URL HTTP/TCP alternative pour un daemon typst-renderd distant (utilisée si RENDER_DAEMON_SOCKET est vide)
# RENDER_DAEMON_URL=http://127.0.0.1:9090

# Dossier temporaire pour le backend CLI (RAM tmpfs /dev/shm recommandé sous Linux/Docker)
# Laisser vide pour auto-détection (/dev/shm/fx-render ou ./tmp/fx-render sous Snap)
RENDER_TMP_DIR=/dev/shm/fx-render

# Ignorer les polices système de l'hôte (true = uniquement polices embarquées Typst + TYPST_FONT_PATHS)
TYPST_IGNORE_SYSTEM_FONTS=false

# Nombre maximal de documents autorisés par requête POST /api/v1/render/batch
RENDER_MAX_BATCH_SIZE=100

# Option de build Docker : activer/désactiver la compilation du Turbo Daemon Rust (true/false)
# ENABLE_RUST_DAEMON=true

# === Feature Flags ===
# Active l'éditeur visuel Studio v2 (Blueprints, thèmes, presets) et l'API universelle (/api/v1/render, /api/v1/studio/*)
STUDIO_ENABLED=true

# Active le mode "template Typst custom" (découplé de Factur-X):
# expose les endpoints /api/v1/custom/* et la page d'édition dédiée dans l'UI.
ALLOW_CUSTOM_TEMPLATES=true

# === Templates & Polices Typst ===
# Note sécurité v2 : chaque compilation est isolée dans son propre sandbox --root <jobDir>.
TEMPLATES_PATH=./templates-custom
# Dossier contenant des polices d'écriture additionnelles pour Typst (séparés par ':' si multiples)
# TYPST_FONT_PATHS=./fonts

# === AI Generation ===
# 1. Google Gemini (via OpenAI API compatibility)
AI_PROVIDER=openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-4-hydrogen
AI_API_KEY=your-api-key-here

# 2. DeepSeek (via OpenAI API compatibility)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-coder-v4pro # ou deepseek-chat
# AI_API_KEY=your-deepseek-key-here

# 3. Ollama (Local)
# L'utilisation de host.docker.internal est souvent nécessaire sous Docker
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=llama3.2
# AI_API_KEY=not-needed

# 4. Mode CLI Local (appelle directement ta CLI IA : agy, claude, gemini, codex ou script perso)
# En local natif (make dev) :
# AI_PROVIDER=cli
# AI_CLI_COMMAND=agy
# AI_MODEL=gemini-4-hydrogen
# AI_CLI_EFFORT=medium
# AI_CLI_TIMEOUT=180
# Optionnel : arguments custom avec placeholders {model}, {effort}, {prompt}, {image}
# AI_CLI_ARGS="--output-format text --disable-slash-commands --model {model} --effort {effort} -p \"{prompt}\""
#
# En Docker Compose (via le bridge hôte `make ai-bridge`) :
# AI_PROVIDER=openai
# AI_BASE_URL=http://host.docker.internal:11436/v1
# AI_MODEL=gemini-4-hydrogen
# AI_API_KEY=local-cli
